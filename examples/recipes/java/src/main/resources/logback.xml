<!-- logback set up to the logwarden logging standard. Copy into src/main/resources.
     https://github.com/Ingeniator/logwarden/blob/main/docs/recipes/java.md
     Resource fields come from env vars (or -D system properties) with these names. -->
<configuration>
  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp><fieldName>timestamp</fieldName><timeZone>UTC</timeZone></timestamp>
        <!-- WARN -> warning, TRACE -> debug, others lower-case -->
        <pattern><pattern>{"level": "%replace(%replace(%replace(%replace(%replace(%level){'TRACE','debug'}){'DEBUG','debug'}){'INFO','info'}){'WARN','warning'}){'ERROR','error'}"}</pattern></pattern>
        <message><fieldName>event</fieldName></message>
        <loggerName><fieldName>logger</fieldName></loggerName>
        <pattern><pattern>{
          "service.name": "${OTEL_SERVICE_NAME}",
          "service.version": "${SERVICE_VERSION}",
          "deployment.environment.name": "${DEPLOYMENT_ENVIRONMENT}"
        }</pattern></pattern>
        <!-- trace_id / span_id: the OpenTelemetry Java agent puts them in the MDC -->
        <mdc/>
        <!-- fields: log.info("order_created", kv("order_id", 42)) -->
        <arguments/>
        <throwableClassName><fieldName>exception.type</fieldName><useSimpleClassName>false</useSimpleClassName></throwableClassName>
        <throwableMessage><fieldName>exception.message</fieldName></throwableMessage>
        <stackTrace><fieldName>exception.stacktrace</fieldName></stackTrace>
      </providers>
    </encoder>
  </appender>

  <root level="${LOG_LEVEL:-INFO}">
    <appender-ref ref="JSON"/>
  </root>
</configuration>
