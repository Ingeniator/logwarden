{
  "name": "logwarden-recipe-node",
  "private": true,
  "description": "pino set up to the logwarden logging standard (stdout JSON or OTLP)",
  "scripts": {
    "stdout": "node app.js > logs.jsonl && logwarden check logs.jsonl",
    "otlp": "logwarden capture -o logs.jsonl -- node --require ./otel.js app.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "pino": "10.4.0"
  },
  "optionalDependencies": {
    "@opentelemetry/api-logs": "0.223.2",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.2",
    "@opentelemetry/instrumentation": "0.223.2",
    "@opentelemetry/instrumentation-pino": "0.69.0",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-logs": "0.223.2"
  }
}
